# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored — never commit real values.
# ---------------------------------------------------------------------------

# Which model provider to use.
#   groq      — free tier, openai/gpt-oss-120b (default)
#   anthropic — paid, claude-opus-5, better translation quality
PROVIDER=groq

# Free key from https://console.groq.com/keys — required when PROVIDER=groq.
#
# Do NOT rename this to VITE_GROQ_API_KEY or put it in frontend/.env:
# Vite inlines every VITE_-prefixed variable into the public JavaScript bundle,
# which would publish your key to anyone who opens devtools.
GROQ_API_KEY=

# Required only when PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Signs the anonymous visitor cookie. Any long random string.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# --- Optional ---------------------------------------------------------------
# Overrides the active provider's default model. Leave unset unless needed.
# MODEL_ID=

# PORT=3001
# DB_PATH=./data/decks.db

# Max characters of pasted lyrics. Defaults to 6,000 on groq (to stay inside
# the free tier's 8,000 tokens/minute) and 20,000 on anthropic.
# MAX_LYRICS_CHARS=

# Groq only. Reasoning tokens count against the per-minute budget.
# REASONING_EFFORT=medium
# MAX_COMPLETION_TOKENS=4096

# Set to true only when serving over HTTPS, otherwise the cookie is dropped.
# COOKIE_SECURE=false

# X-Forwarded-For hops to trust. 0 for local dev, 1 behind nginx in compose.
# TRUST_PROXY=0

# Deck generations allowed per IP per window (your own limit, on top of the
# provider's upstream limits).
# GENERATE_LIMIT=10
# GENERATE_WINDOW_MIN=15
